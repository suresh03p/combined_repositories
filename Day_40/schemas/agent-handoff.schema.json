{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "agent-handoff.schema.json",
  "title": "Agent handoff envelope",
  "description": "Versioned, task-bound message passed between adjacent workflow roles.",
  "type": "object",
  "required": [
    "schema_version",
    "from_role",
    "to_role",
    "task_id",
    "status"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "from_role": {
      "enum": [
        "planner",
        "researcher",
        "validator"
      ]
    },
    "to_role": {
      "enum": [
        "researcher",
        "validator",
        "terminal"
      ]
    },
    "task_id": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "status": {
      "enum": [
        "completed",
        "error"
      ]
    },
    "payload": {
      "type": "object"
    },
    "error": {
      "$ref": "#/$defs/error"
    }
  },
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "completed"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "required": [
          "payload"
        ],
        "not": {
          "required": [
            "error"
          ]
        }
      },
      "else": {
        "required": [
          "error"
        ],
        "not": {
          "required": [
            "payload"
          ]
        }
      }
    },
    {
      "oneOf": [
        {
          "properties": {
            "from_role": {
              "const": "planner"
            },
            "to_role": {
              "const": "researcher"
            },
            "status": {
              "const": "completed"
            },
            "payload": {
              "$ref": "role-contracts.schema.json#/$defs/plannerOutput"
            }
          }
        },
        {
          "properties": {
            "from_role": {
              "const": "researcher"
            },
            "to_role": {
              "const": "validator"
            },
            "status": {
              "const": "completed"
            },
            "payload": {
              "$ref": "role-contracts.schema.json#/$defs/researcherOutput"
            }
          }
        },
        {
          "properties": {
            "from_role": {
              "const": "validator"
            },
            "to_role": {
              "const": "terminal"
            },
            "status": {
              "const": "completed"
            },
            "payload": {
              "$ref": "role-contracts.schema.json#/$defs/validatorOutput"
            }
          }
        },
        {
          "properties": {
            "from_role": {
              "const": "planner"
            },
            "to_role": {
              "const": "researcher"
            },
            "status": {
              "const": "error"
            }
          }
        },
        {
          "properties": {
            "from_role": {
              "const": "researcher"
            },
            "to_role": {
              "const": "validator"
            },
            "status": {
              "const": "error"
            }
          }
        },
        {
          "properties": {
            "from_role": {
              "const": "validator"
            },
            "to_role": {
              "const": "terminal"
            },
            "status": {
              "const": "error"
            }
          }
        }
      ]
    }
  ],
  "$defs": {
    "error": {
      "type": "object",
      "required": [
        "code",
        "message"
      ],
      "properties": {
        "code": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "message": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        }
      },
      "additionalProperties": false
    }
  }
}
