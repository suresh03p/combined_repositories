{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "role-contracts.schema.json",
  "title": "Agent role input and output contracts",
  "$defs": {
    "plannerInput": {
      "type": "object",
      "required": [
        "task_id",
        "goal",
        "idempotency_key"
      ],
      "properties": {
        "task_id": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "goal": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "idempotency_key": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        }
      },
      "additionalProperties": false
    },
    "plannerOutput": {
      "type": "object",
      "required": [
        "goal",
        "research_questions"
      ],
      "properties": {
        "goal": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "research_questions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          }
        }
      },
      "additionalProperties": false
    },
    "researcherInput": {
      "type": "object",
      "required": [
        "schema_version",
        "from_role",
        "to_role",
        "task_id",
        "status",
        "payload"
      ],
      "properties": {
        "schema_version": {
          "const": "1.0"
        },
        "from_role": {
          "const": "planner"
        },
        "to_role": {
          "const": "researcher"
        },
        "task_id": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "status": {
          "const": "completed"
        },
        "payload": {
          "$ref": "#/$defs/plannerOutput"
        }
      },
      "additionalProperties": false
    },
    "researcherOutput": {
      "type": "object",
      "required": [
        "findings",
        "limitations"
      ],
      "properties": {
        "findings": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "claim",
              "evidence"
            ],
            "properties": {
              "claim": {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              },
              "evidence": {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              }
            },
            "additionalProperties": false
          }
        },
        "limitations": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          }
        }
      },
      "additionalProperties": false
    },
    "validatorInput": {
      "type": "object",
      "required": [
        "schema_version",
        "from_role",
        "to_role",
        "task_id",
        "status",
        "payload"
      ],
      "properties": {
        "schema_version": {
          "const": "1.0"
        },
        "from_role": {
          "const": "researcher"
        },
        "to_role": {
          "const": "validator"
        },
        "task_id": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "status": {
          "const": "completed"
        },
        "payload": {
          "$ref": "#/$defs/researcherOutput"
        }
      },
      "additionalProperties": false
    },
    "validatorOutput": {
      "type": "object",
      "required": [
        "accepted",
        "answer",
        "issues"
      ],
      "properties": {
        "accepted": {
          "type": "boolean"
        },
        "answer": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "issues": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          }
        }
      },
      "additionalProperties": false
    }
  }
}
