class InfiniteCounter:

    def __init__(self, start=0):
        self.current = start

    def __iter__(self):
        return self

    def __next__(self):

        value = self.current
        self.current += 1

        return value


# Main Program
counter = InfiniteCounter(1)

for _ in range(10):  # Limit to 10 values
    print(next(counter))